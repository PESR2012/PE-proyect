void limpiarPantalla() { system("cls"); }                                       /* FUNCIONES */
void pausar() { printf("\nPresiona una tecla para continuar..."); getch(); }    /* DE UTILIDAD */

typedef struct {
char id[10];
char nombre[50];
char apellido[50];      /* ESTRUCTURA DE PROFESORES */
char departamento[30];
} Profesor;

typedef struct {
    char id[10];
    char nombre[50];
    char apellido[50]; /* ESTRUCTURA DE ALUMNOS */
    char carrera[30];
} Alumno;

    //Variables :)
const char *PoA[]={"Alumno(s)", "Profesor(es)"};
int tipos;     //declarar para decidir entre 1 = alumno, o 2 = Profesor
Alumno *listaAlumnos = NULL; /* PUNTERO HACIA EL VALOR DE LISTA DE ALUMNOS */
int totalAlumnos = 0;
Profesor *listaProfesores = NULL; /* PUNTERO HACIA EL VALOR DE LISTA DE ALUMNOS */
int totalProfesores = 0;

void cargar() {
    FILE *archivo = fopen("alumnos.txt", "r");
    if (!archivo) return;                                                               /* fUNCION */
                                                                                        /* DE CARGA */
    Alumno temp;                                                                        /* PARA ALUMNOS */
    while (fscanf(archivo, "%[^,],%[^,],%[^,],%[^\n]\n",
                  temp.id, temp.nombre, temp.apellido, temp.carrera) == 4) {
        Alumno *nuevaLista = realloc(listaAlumnos, (totalAlumnos + 1) * sizeof(Alumno));
        if (!nuevaLista) break;
        listaAlumnos = nuevaLista;
        listaAlumnos[totalAlumnos++] = temp;
    }
    fclose(archivo);
    /* $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$  */
}
void cargarprofesores() {
    FILE *archivo = fopen("profesores.txt", "r");
    if (!archivo) return;                                                                /* fUNCION */
                                                                                         /* DE CARGA */
    Profesor temp;                                                                       /* PARA PROFESORES */
    while (fscanf(archivo, "%[^,],%[^,],%[^,],%[^\n]\n",
                  temp.id, temp.nombre, temp.apellido, temp.departamento) == 4) {
        Profesor *nuevaLista = realloc(listaProfesores, (totalProfesores + 1) * sizeof(Profesor));
        if (!nuevaLista) break;
        listaProfesores = nuevaLista;
        listaProfesores[totalProfesores++] = temp;
    }
    fclose(archivo);
}

void guardarAlumnos() {
    FILE *archivo = fopen("alumnos.txt", "w");                                           /* fUNCION */
    if (!archivo) return;                                                                /* DE GUARDADO */
    for (int i = 0; i < totalAlumnos; i++) {                                             /* PARA ALUMNOS */
        fprintf(archivo, "%s,%s,%s,%s\n",
                listaAlumnos[i].id,
                listaAlumnos[i].nombre,
                listaAlumnos[i].apellido,
                listaAlumnos[i].carrera);
    }
    fclose(archivo);

}

void guardarprofesores() {
    FILE *archivo = fopen("profesores.txt", "w");                                         /* fUNCION */
    if (!archivo) return;                                                                 /* DE GUARDADO */
    for (int i = 0; i < totalProfesores; i++) {                                           /* PARA PROFESORES */
        fprintf(archivo, "%s,%s,%s,%s\n",
                listaProfesores[i].id,
                listaProfesores[i].nombre,
                listaProfesores[i].apellido,
                listaProfesores[i].departamento);
    }
    fclose(archivo);
}
