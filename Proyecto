void eliminar() {
    limpiarPantalla();
    printf("=== ELIMINAR %s===\n\n", PoA[tipos]);

    char id[10];
    printf("Ingrese el ID &s: ", PoA);
    fflush(stdin);
    fgets(id, sizeof(id), stdin);
    id[strcspn(id, "\n")] = 0;

    if(PoA[tipos]=="Alumno(s)"){
        for (int i = 0; i < totalAlumnos; i++) {
            if (strcmp(listaAlumnos[i].id, id) == 0) {
                memmove(&listaAlumnos[i], &listaAlumnos[i + 1], (totalAlumnos - i - 1) * sizeof(Alumno));
                totalAlumnos--;
                listaAlumnos = realloc(listaAlumnos, totalAlumnos * sizeof(Alumno));
                printf("\nAlumno eliminado correctamente.\n");
                Sleep(700);
                return;
            }
        }

        printf("\nAlumno no encontrado.\n");
        pausar();
    }
    else if(PoA[tipos]=="Profesor(es)"){
        for (int i = 0; i < totalProfesores; i++) {
            if (strcmp(listaProfesores[i].id, id) == 0) {
                memmove(&listaProfesores[i], &listaProfesores[i + 1], (totalProfesores - i - 1) * sizeof(Profesor));
                totalProfesores--;
                listaProfesores = realloc(listaProfesores, totalProfesores * sizeof(Profesor));
                printf("\nProfesor eliminado correctamente.\n");
                Sleep(700);
                return;
            }
        }

        printf("\nProfesor no encontrado.\n");
        pausar();
    }
}
