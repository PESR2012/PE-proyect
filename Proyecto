void consultar() {
    limpiarPantalla();
    printf("=== Consultar %s===\n\n", PoA[tipos]);

    if (PoA[tipos]=="Alumno(s)"){
        if (totalAlumnos == 0) {
            printf("No hay alumnos registrados.\n");
        }
        else {
            for (int i = 0; i < totalAlumnos; i++) {
                printf("%d) %s %s - %s (%s)\n", i + 1,
                   listaAlumnos[i].nombre,
                   listaAlumnos[i].apellido,
                   listaAlumnos[i].id,
                   listaAlumnos[i].carrera);
            }
        }
    }
    else if(PoA[tipos]=="Profesor(es)"){
        if (totalProfesores == 0) {
            printf("No hay Profesores registrados.\n");
        }
        else {
            for (int i = 0; i < totalProfesores; i++) {
                printf("%d) %s %s - %s (%s)\n", i + 1,
                   listaProfesores[i].nombre,
                   listaProfesores[i].apellido,
                   listaProfesores[i].id,
                   listaProfesores[i].departamento);
