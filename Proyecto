void menuCRUD() {
    int opcion = 0, tecla;
    const char *opciones[] = {
        "Agregar",
        "Consultar",
        "Buscar",
        "Modificar",
        "Eliminar",
        "Regresar al Menu Principal"
    };
    int n = 6;

    while (1) {
        limpiarPantalla();
        printf("=== GESTION %s ===\n\n", PoA[tipos]);
        for (int i = 0; i < n; i++)
            printf("%s%s%s\n", (i == opcion ? " > " : "   "), opciones[i], (i == opcion ? " <" : ""));

        tecla = getch();
        if (tecla == 72) opcion = (opcion - 1 + n) % n;
        else if (tecla == 80) opcion = (opcion + 1) % n;
        else if (tecla == 13) {
            switch (opcion) {
                case 0: agregar(); break;
                case 1: consultar(); break;
                case 2: buscar(); break;
                case 3: modificar(); break;
                case 4: eliminar(); break;
                case 5: return;
            }
        }
    }
}

void menuPrincipal() {
    int opcion = 0, tecla;
    const char *opciones[] = {
        "Gestion de Alumnos",
        "Gestion de Profesores",
        "Guardar y Salir"
    };
    int n = 3;

    while (1) {
        limpiarPantalla();
        printf("=== SISTEMA DE GESTION ACADEMICA 'CUCEI' ===\n\n");

        for (int i = 0; i < n; i++)
            printf("%s%s%s\n", (i == opcion ? " > " : "   "), opciones[i], (i == opcion ? " <" : ""));

        tecla = getch();
        if (tecla == 72) opcion = (opcion - 1 + n) % n;
        else if (tecla == 80) opcion = (opcion + 1) % n;
        else if (tecla == 13) {
            switch (opcion) {
                case 0: tipos = 0; menuCRUD(); break;
                case 1: tipos = 1; menuCRUD(); break;
                case 2: guardarAlumnos();
                    guardarprofesores();
                    free(listaAlumnos);
                    free(listaProfesores);
                    printf("\nDatos guardados. Saliendo...\n");
                    Sleep(800);
                    exit(0);
            }
        }
    }
}

